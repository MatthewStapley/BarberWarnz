---
import Container from "../ui/Container.astro";
import { siteConfig } from "../../lib/site-config";

const year = new Date().getFullYear();
---

<footer class="border-t border-(--color-line) py-16 pb-32 md:pb-16">
  <Container class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
    <div>
      <p class="font-(family-name:--font-display) text-2xl uppercase tracking-[0.15em] text-(--color-ink)">
        {siteConfig.business.name}
      </p>
      <p class="mt-3 max-w-xs text-sm text-(--color-ink-muted)">
        {siteConfig.business.tagline}
      </p>
    </div>

    <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
      <div>
        <p class="mb-3 text-xs uppercase tracking-[0.2em] text-(--color-ink-faint)">Contact</p>
        <ul class="space-y-2 text-sm text-(--color-ink-muted)">
          <li>{siteConfig.contact.phone}</li>
          <li>{siteConfig.contact.email}</li>
        </ul>
      </div>
      <div>
        <p class="mb-3 text-xs uppercase tracking-[0.2em] text-(--color-ink-faint)">Menu</p>
        <ul class="space-y-2 text-sm text-(--color-ink-muted)">
          {siteConfig.nav.map((item) => (
            <li><a href={item.href} class="transition-colors hover:text-(--color-ink)">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="mb-3 text-xs uppercase tracking-[0.2em] text-(--color-ink-faint)">Follow</p>
        <ul class="space-y-2 text-sm text-(--color-ink-muted)">
          {siteConfig.social.map((item) => (
            <li><a href={item.href} class="transition-colors hover:text-(--color-ink)">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </Container>

  <Container class="mt-16 flex flex-col-reverse items-start justify-between gap-4 border-t border-(--color-line) pt-6 text-xs text-(--color-ink-faint) sm:flex-row sm:items-center">
    <p>&copy; {year} {siteConfig.business.name}. All rights reserved.</p>
    <p>Site by AI Web Agency — placeholder</p>
  </Container>
</footer>
