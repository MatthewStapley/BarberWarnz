---
import { siteConfig } from "../../lib/site-config";
---

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-(--color-line) bg-(--color-bg)/95 px-6 py-4 backdrop-blur-md md:hidden">
  <a
    href={siteConfig.booking.url}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-sheen relative flex w-full items-center justify-center gap-2 rounded-full bg-(--color-accent) px-6 py-3.5 text-sm font-medium text-(--color-bg) shadow-[0_8px_30px_-12px_rgb(184_103_47/0.55)] transition-transform duration-(--duration-fast) ease-(--ease-premium) active:scale-[0.98]"
  >
    {siteConfig.booking.label} — {siteConfig.business.shortName}
    <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 8h10M9 4l4 4-4 4" />
    </svg>
  </a>
</div>
