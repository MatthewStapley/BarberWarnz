---
// Responsive container for an interactive Google Maps embed.
//
// Currently using Google's no-API-key embed format (`/maps?q=...&output=embed`),
// built straight from the verified address in site-config.ts — no key or
// billing account needed. If a proper "Share -> Embed a map" pb= URL is
// ever supplied instead, it can just replace `contact.mapsEmbedUrl` as-is;
// this component doesn't care which flavour of embed URL it gets.
//
// Falls back to a plain text placeholder (no fake map graphic) if
// `embedUrl` is ever unset.
interface Props {
  address: string;
  embedUrl?: string | null;
  class?: string;
}
const { address, embedUrl, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "relative aspect-square w-full overflow-hidden rounded-sm border border-(--color-line) bg-(--color-bg-elevated)",
    className,
  ]}
>
  {embedUrl ? (
    <iframe
      src={embedUrl}
      class="absolute inset-0 h-full w-full grayscale-[35%] contrast-[1.05] brightness-[0.92]"
      style="border:0"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
      title={`Map to ${address}`}
    />
  ) : (
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">
      <span class="text-xs uppercase tracking-[0.2em] text-(--color-ink-faint)">
        Interactive map coming soon
      </span>
      <span class="text-sm text-(--color-ink-muted)">{address}</span>
    </div>
  )}
</div>
