---
// Section divider and the site's one barber motif: a hairline that "cuts"
// across on scroll, led by a small line-art pair of shears that gives a
// single quiet snip when it arrives (styles in global.css → .cut-line).
// Use sparingly — it should read as an editorial detail, not decoration.
import Container from "./Container.astro";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<Container class={className}>
  <div class="cut-line" aria-hidden="true">
    <div class="cut-line__track">
      <span class="cut-line__rule"></span>
      <svg
        class="cut-line__shears"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <g class="cut-line__blade cut-line__blade--a">
          <circle cx="4.6" cy="7" r="2.6" />
          <path d="M7 8.2 11.5 12 22.5 14.6" />
        </g>
        <g class="cut-line__blade cut-line__blade--b">
          <circle cx="4.6" cy="17" r="2.6" />
          <path d="M7 15.8 11.5 12 22.5 9.4" />
        </g>
        <circle cx="11.5" cy="12" r="0.7" fill="currentColor" stroke="none" />
      </svg>
    </div>
  </div>
</Container>
