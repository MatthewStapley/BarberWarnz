---
// Five-star rating glyphs. Purely presentational — callers must pass the
// real rating so the accessible label never claims more than the source.
interface Props {
  rating: number;
  class?: string;
}
const { rating, class: className = "h-3.5 w-3.5" } = Astro.props;
const filled = Math.round(rating);
---

<span class="inline-flex items-center gap-0.5" role="img" aria-label={`Rated ${rating} out of 5`}>
  {Array.from({ length: 5 }, (_, i) => (
    <svg viewBox="0 0 20 20" class:list={[className, i < filled ? "text-(--color-accent)" : "text-(--color-line)"]} aria-hidden="true">
      <path fill="currentColor" d="M10 1.6l2.47 5.18 5.68.66-4.2 3.88 1.12 5.6L10 14.14l-5.07 2.78 1.12-5.6-4.2-3.88 5.68-.66z" />
    </svg>
  ))}
</span>
