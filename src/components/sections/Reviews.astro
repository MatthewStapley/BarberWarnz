---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import RevealOnScroll from "../ui/RevealOnScroll";
import { siteConfig } from "../../lib/site-config";
---

<section id="reviews" class="border-t border-(--color-line) py-(--spacing-section) md:py-(--spacing-section-lg)">
  <Container>
    <SectionHeading eyebrow="Reviews" title="Trusted by regulars." />

    <RevealOnScroll client:visible stagger class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
      {siteConfig.reviews.map((review) => (
        <div class="rounded-sm border border-(--color-line) bg-(--color-bg-elevated) p-8">
          <p class="text-(--color-accent)">★★★★★</p>
          <p class="mt-4 text-base leading-relaxed text-(--color-ink-muted)">
            "{review.quote}"
          </p>
          <p class="mt-6 text-sm text-(--color-ink-faint)">— {review.author}</p>
        </div>
      ))}
    </RevealOnScroll>
  </Container>
</section>
