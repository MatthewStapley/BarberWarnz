---
import { getImage } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ParallaxImage from "../ui/ParallaxImage";
import Button from "../ui/Button.astro";
import IconInstagram from "../ui/IconInstagram.astro";
import { siteConfig } from "../../lib/site-config";

import result1 from "../../assets/photos/gallery-result-1.jpg";
import result2 from "../../assets/photos/gallery-result-2.jpg";
import result3 from "../../assets/photos/gallery-result-3.jpg";
import result4 from "../../assets/photos/gallery-result-4.jpg";
import process1 from "../../assets/photos/gallery-process-1.jpg";
import process2 from "../../assets/photos/gallery-process-2.jpg";
import process3 from "../../assets/photos/gallery-process-3.jpg";
import process4 from "../../assets/photos/gallery-process-4.jpg";

const tiles = [
  { source: result1, alt: "Finished fade with a custom line design", ratio: "aspect-[3/4]", span: "" },
  { source: process1, alt: "Barber Warnz barber mid-cut", ratio: "aspect-[3/4]", span: "sm:translate-y-8" },
  { source: result2, alt: "Finished fade with a side hair-line design", ratio: "aspect-[3/4]", span: "" },
  { source: process2, alt: "Detail of a fresh fade being finished with a comb", ratio: "aspect-[3/4]", span: "sm:translate-y-8" },
  { source: result3, alt: "Finished cut with a wave line detail", ratio: "aspect-[3/4]", span: "" },
  { source: process3, alt: "Scissor work detail on a fresh cut", ratio: "aspect-[3/4]", span: "sm:translate-y-8" },
  { source: result4, alt: "Finished fade with a neckline design", ratio: "aspect-[3/4]", span: "" },
  { source: process4, alt: "Close detail of clipper work at the temple", ratio: "aspect-[3/4]", span: "sm:translate-y-8" },
];

const images = await Promise.all(
  tiles.map((tile) => getImage({ src: tile.source, width: 640, format: "webp", quality: 80 }))
);
---

<section id="gallery" class="py-(--spacing-section) md:py-(--spacing-section-lg)">
  <Container>
    <SectionHeading eyebrow="Gallery" title="The work speaks first." />

    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {tiles.map((tile, i) => (
        <ParallaxImage
          client:visible
          src={images[i].src}
          width={images[i].attributes.width}
          height={images[i].attributes.height}
          alt={tile.alt}
          ratio={tile.ratio}
          wrapperClass={tile.span}
        />
      ))}
    </div>

    <div class="mt-10 flex justify-center md:mt-12">
      <Button href={siteConfig.social[0].href} target="_blank" variant="outline">
        <IconInstagram class="h-4 w-4" />
        See More Cuts on Instagram
      </Button>
    </div>
  </Container>
</section>
