---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import CutLine from "../ui/CutLine.astro";
import { siteConfig } from "../../lib/site-config";
---

<section id="services" class="pb-(--spacing-section) md:pb-(--spacing-section-lg)">
  <CutLine />

  <Container class="pt-(--spacing-section) md:pt-(--spacing-section-lg)">
    <SectionHeading eyebrow="Services" title="What I do." />

    <!-- Each row books straight through Booksy -->
    <div data-reveal-stagger class="divide-y divide-(--color-line) border-y border-(--color-line)">
      {siteConfig.services.map((service) => (
        <a
          href={siteConfig.booking.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Book ${service.name}, ${service.duration}, ${service.price}`}
          class="group relative isolate flex items-center justify-between gap-6 py-6"
        >
          <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-y-0 -inset-x-4 -z-10 origin-left scale-x-[0.98] rounded-sm bg-(--color-bg-elevated) opacity-0 transition-[opacity,transform] duration-500 ease-(--ease-premium) group-hover:scale-x-100 group-hover:opacity-100 md:-inset-x-6"
          ></span>
          <span class="transition-transform duration-500 ease-(--ease-premium) group-hover:translate-x-1.5">
            <span class="block font-(family-name:--font-display) text-xl text-(--color-ink) sm:text-2xl">
              {service.name}
            </span>
            <span class="mt-1 block text-sm text-(--color-ink-faint)">{service.duration}</span>
          </span>
          <span class="flex shrink-0 items-center gap-4">
            <span class="hidden translate-x-2 text-xs uppercase tracking-[0.2em] text-(--color-ink-muted) opacity-0 transition-[opacity,transform] duration-500 ease-(--ease-premium) group-hover:translate-x-0 group-hover:opacity-100 sm:inline">
              Book
            </span>
            <span class="text-lg text-(--color-accent) transition-colors duration-(--duration-fast) group-hover:text-(--color-accent-soft)">{service.price}</span>
          </span>
        </a>
      ))}
    </div>

    <p class="mt-6 text-center text-sm text-(--color-ink-faint)">{siteConfig.servicesNote}</p>

    <div class="mt-6 flex flex-wrap justify-center gap-4">
      <Button href={siteConfig.booking.url} target="_blank">{siteConfig.booking.label}</Button>
      <Button href={siteConfig.booking.url} target="_blank" variant="outline">Full Price List</Button>
    </div>
  </Container>
</section>
