---
import { getImage } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ParallaxImage from "../ui/ParallaxImage";
import RevealOnScroll from "../ui/RevealOnScroll";
import { siteConfig } from "../../lib/site-config";
import aboutSource from "../../assets/photos/about.jpg";

const about = await getImage({ src: aboutSource, width: 900, format: "webp", quality: 82 });
---

<section id="about" class="py-(--spacing-section) md:py-(--spacing-section-lg)">
  <Container class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-20">
    <ParallaxImage
      client:visible
      src={about.src}
      width={about.attributes.width}
      height={about.attributes.height}
      alt="Callum Warnes finishing a client's cut at Barber Warnz"
      ratio="aspect-[4/5]"
      wrapperClass="order-1 md:order-none"
    />

    <div>
      <SectionHeading eyebrow="About" title={`Hi, I'm ${siteConfig.barber.name.split(" ")[0]}.`} />
      <RevealOnScroll client:visible>
        <p class="max-w-md text-base leading-relaxed text-(--color-ink-muted) md:text-lg">
          I'm based at {siteConfig.contact.shortLocation} — one-to-one, no rush,
          no queue of chairs. Just a proper conversation and a precise fade,
          in a relaxed, private setting.
        </p>
        <p class="mt-4 max-w-md text-base leading-relaxed text-(--color-ink-muted) md:text-lg">
          It shows: {siteConfig.stats.rating} stars from {siteConfig.stats.reviewCount} Booksy
          reviews, and a few regulars who've stuck with me for years.
        </p>
      </RevealOnScroll>
    </div>
  </Container>
</section>
