---
import { getImage } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ParallaxImage from "../ui/ParallaxImage";
import RevealOnScroll from "../ui/RevealOnScroll";
import aboutSource from "../../assets/photos/about.jpg";

const about = await getImage({ src: aboutSource, width: 900, format: "webp", quality: 82 });
---

<section id="about" class="py-(--spacing-section) md:py-(--spacing-section-lg)">
  <Container class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-20">
    <ParallaxImage
      client:visible
      src={about.src}
      width={about.attributes.width}
      height={about.attributes.height}
      alt="A Barber Warnz barber finishing a client's cut"
      ratio="aspect-[4/5]"
      wrapperClass="order-1 md:order-none"
    />

    <div>
      <SectionHeading eyebrow="The Shop" title="Craft, not conveyor belts." />
      <RevealOnScroll client:visible>
        <p class="max-w-md text-base leading-relaxed text-(--color-ink-muted) md:text-lg">
          PLACEHOLDER copy — replace with the real Barber Warnz story: the chairs,
          the team, the neighbourhood, what makes a visit feel different here.
          Two to three short paragraphs works best for this layout.
        </p>
        <p class="mt-4 max-w-md text-base leading-relaxed text-(--color-ink-muted) md:text-lg">
          PLACEHOLDER — second paragraph. Keep it editorial and confident rather
          than sales-y; the photography should carry most of the persuasion.
        </p>
      </RevealOnScroll>
    </div>
  </Container>
</section>
