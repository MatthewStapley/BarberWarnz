---
import { getImage } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ParallaxImage from "../ui/ParallaxImage";
import PlaceholderImage from "../ui/PlaceholderImage.astro";
import RevealOnScroll from "../ui/RevealOnScroll";
import { siteConfig } from "../../lib/site-config";
import aboutSource from "../../assets/photos/about.jpg";

const about = await getImage({ src: aboutSource, width: 900, format: "webp", quality: 82 });

// "Beyond the chair" — life-outside-barbering cards.
// No real photos or facts yet: Callum will supply both later. To wire a
// real one in, import the photo like `aboutSource` above, process it with
// getImage() the same way, and swap that card's <PlaceholderImage> below
// for <ParallaxImage client:visible src={...} ratio="aspect-[4/5]" alt="..." />
// (identical pattern to the main photo higher up this file). Update the
// caption text at the same time.
const lifeCards = [
  { label: "DOG PHOTO", caption: "PLACEHOLDER — caption once details confirmed" },
  { label: "TRIATHLON PHOTO", caption: "PLACEHOLDER — caption once details confirmed" },
  { label: "PERSONAL INTEREST", caption: "PLACEHOLDER — caption once details confirmed" },
];
---

<section id="about" class="py-(--spacing-section) md:py-(--spacing-section-lg)">
  <Container class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-20">
    <ParallaxImage
      client:visible
      src={about.src}
      width={about.attributes.width}
      height={about.attributes.height}
      alt="Callum Warnes finishing a client's cut at Barber Warnz"
      ratio="aspect-[4/5]"
      wrapperClass="order-1 md:order-none"
    />

    <div>
      <SectionHeading eyebrow="About" title={`Hi, I'm ${siteConfig.barber.name.split(" ")[0]}.`} />
      <RevealOnScroll client:visible>
        <p class="max-w-md text-base leading-relaxed text-(--color-ink-muted) md:text-lg">
          I'm based at {siteConfig.contact.shortLocation} — just me, one chair,
          no rush. Good conversation, a bit of football chat if you're up
          for it, and proper attention on getting the cut right.
        </p>
        <p class="mt-4 max-w-md text-base leading-relaxed text-(--color-ink-muted) md:text-lg">
          That's really it — solid cuts, an easy atmosphere, and a lot of
          regulars who keep coming back. {siteConfig.stats.rating} stars
          from {siteConfig.stats.reviewCount} reviews on Booksy.
        </p>
      </RevealOnScroll>
    </div>
  </Container>

  <Container class="mt-20 md:mt-28">
    <p class="mb-8 text-xs font-medium uppercase tracking-[0.25em] text-(--color-accent) md:mb-10">
      Beyond the Chair
    </p>
    <RevealOnScroll client:visible stagger wrapperClass="grid grid-cols-1 gap-8 sm:grid-cols-3 sm:gap-6">
      {lifeCards.map((card) => (
        <div>
          <PlaceholderImage label={card.label} ratio="aspect-[4/5]" />
          <p class="mt-3 text-sm text-(--color-ink-faint)">{card.caption}</p>
        </div>
      ))}
    </RevealOnScroll>
  </Container>
</section>
