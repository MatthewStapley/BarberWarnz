---
import { getImage } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import ParallaxImage from "../ui/ParallaxImage";
import RevealOnScroll from "../ui/RevealOnScroll";
import { siteConfig } from "../../lib/site-config";
import aboutSource from "../../assets/photos/about.jpg";
import marathonSource from "../../assets/photos/about-marathon.jpg";
import dogSource from "../../assets/photos/about-dog.jpg";
import medalSource from "../../assets/photos/about-medal.jpg";

const about = await getImage({ src: aboutSource, width: 900, format: "webp", quality: 82 });

// "Beyond the chair" — real photos: Venice Marathon (running + medal) and
// Callum's dog. To swap any of these later, replace the source file in
// src/assets/photos/ (keep the same filename) or update the import path
// below — no other changes needed.
const [marathon, dog, medal] = await Promise.all([
  getImage({ src: marathonSource, width: 900, format: "webp", quality: 82 }),
  getImage({ src: dogSource, width: 700, format: "webp", quality: 82 }),
  getImage({ src: medalSource, width: 700, format: "webp", quality: 82 }),
]);
---

<section id="about" class="py-(--spacing-section) md:py-(--spacing-section-lg)">
  <Container class="grid grid-cols-1 items-center gap-12 md:grid-cols-2 md:gap-20">
    <ParallaxImage
      client:visible
      src={about.src}
      width={about.attributes.width}
      height={about.attributes.height}
      alt="Callum Warnes finishing a client's cut at Barber Warnz"
      ratio="aspect-[4/5]"
      wrapperClass="order-1 md:order-none"
    />

    <div>
      <SectionHeading eyebrow="About" title={`Hi, I'm ${siteConfig.barber.name.split(" ")[0]}.`} />
      <RevealOnScroll client:visible>
        <p class="max-w-md text-base leading-relaxed text-(--color-ink-muted) md:text-lg">
          I'm based at {siteConfig.contact.shortLocation} — just me, one chair,
          no rush. Good conversation, a bit of football chat if you're up
          for it, and proper attention on getting the cut right.
        </p>
        <p class="mt-4 max-w-md text-base leading-relaxed text-(--color-ink-muted) md:text-lg">
          That's really it — solid cuts, an easy atmosphere, and a lot of
          regulars who keep coming back. {siteConfig.stats.rating} stars
          from {siteConfig.stats.reviewCount} reviews on Booksy.
        </p>
      </RevealOnScroll>
    </div>
  </Container>

  <Container class="mt-20 md:mt-28">
    <p class="mb-8 text-xs font-medium uppercase tracking-[0.25em] text-(--color-accent) md:mb-10">
      Beyond the Chair
    </p>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-12">
      <ParallaxImage
        client:visible
        src={marathon.src}
        width={marathon.attributes.width}
        height={marathon.attributes.height}
        alt="Callum running the Venice Marathon through St Mark's Square"
        ratio="aspect-[4/3]"
        wrapperClass="sm:col-span-7"
      />
      <div class="grid grid-cols-1 gap-6 sm:col-span-5">
        <ParallaxImage
          client:visible
          src={dog.src}
          width={dog.attributes.width}
          height={dog.attributes.height}
          alt="Rocky, Callum's dog"
          ratio="aspect-[4/5]"
        />
        <ParallaxImage
          client:visible
          src={medal.src}
          width={medal.attributes.width}
          height={medal.attributes.height}
          alt="Callum with his Venice Marathon finisher's medal"
          ratio="aspect-[4/5]"
        />
      </div>
    </div>

    <RevealOnScroll client:visible wrapperClass="mt-8 max-w-2xl md:mt-10">
      <p class="text-base leading-relaxed text-(--color-ink-muted) md:text-lg">
        When I'm not cutting hair I'm usually out running, on the bike, or in
        the gym — Saints at the weekend, F1 when it's on, good music and a bit
        of travel when I can. And meet my dog Rocky, who thinks every walk's
        an adventure and who'll give you a paw of approval for every cut.
      </p>
    </RevealOnScroll>
  </Container>
</section>
