---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import RevealText from "../ui/RevealText";
import { siteConfig } from "../../lib/site-config";
---

<section class="border-t border-(--color-line) py-(--spacing-section) text-center md:py-(--spacing-section-lg)">
  <Container>
    <h2 class="mx-auto max-w-2xl font-(family-name:--font-display) text-4xl leading-[1.05] text-(--color-ink) sm:text-5xl md:text-6xl">
      <RevealText text="Let's get you booked in." client:visible />
    </h2>
    <p class="mx-auto mt-6 max-w-md text-(--color-ink-muted)">
      Choose your service, pick a time, and book through Booksy.
    </p>
    <div class="mt-9 flex justify-center">
      <Button href={siteConfig.booking.url} target="_blank">{siteConfig.booking.label}</Button>
    </div>
  </Container>
</section>
