---
import { getImage } from "astro:assets";
import RevealText from "../ui/RevealText";
import ParallaxImage from "../ui/ParallaxImage";
import Button from "../ui/Button.astro";
import { siteConfig } from "../../lib/site-config";
import heroSource from "../../assets/photos/hero.jpg";

const hero = await getImage({
  src: heroSource,
  width: 1080,
  format: "webp",
  quality: 82,
});
---

<section class="relative isolate flex h-[100svh] min-h-[640px] w-full items-end overflow-hidden">
  <div class="absolute inset-0">
    <ParallaxImage
      client:load
      src={hero.src}
      width={hero.attributes.width}
      height={hero.attributes.height}
      alt="Close detail of a Barber Warnz cut in progress"
      ratio="h-full"
      priority
      bare
    />

    <div class="absolute inset-0 bg-gradient-to-t from-(--color-bg) via-(--color-bg)/35 to-transparent"></div>
    <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-(--color-bg)/70 to-transparent"></div>
  </div>

  <div class="relative mx-auto w-full max-w-(--container-max) px-6 pb-20 md:px-10 md:pb-28">
    <p class="mb-5 text-xs font-medium uppercase tracking-[0.3em] text-(--color-accent)">
      {siteConfig.contact.shortLocation}
    </p>
    <h1 class="max-w-3xl font-(family-name:--font-display) text-5xl leading-[1.02] text-(--color-ink) sm:text-6xl md:text-7xl lg:text-8xl">
      <RevealText text={siteConfig.business.name} client:visible />
    </h1>
    <p class="mt-6 max-w-md text-base text-(--color-ink-muted) md:text-lg">
      {siteConfig.business.heroSubtext}
    </p>
    <div class="mt-9 flex flex-wrap gap-4">
      <Button href={siteConfig.booking.url} target="_blank">{siteConfig.booking.label}</Button>
      <Button href="#services" variant="outline">View Services</Button>
    </div>
  </div>
</section>
