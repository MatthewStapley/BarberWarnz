---
import "../styles/global.css";
import Header from "../components/layout/Header";
import Footer from "../components/layout/Footer.astro";
import MobileBookingBar from "../components/layout/MobileBookingBar.astro";
import SmoothScroll from "../components/SmoothScroll";
import { siteConfig } from "../lib/site-config";
import { getImage } from "astro:assets";
import logoBadgeSource from "../assets/photos/callum_logo_badge.png";

const logoBadge = await getImage({ src: logoBadgeSource, width: 120, format: "webp", quality: 90 });

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.business.name} — ${siteConfig.business.tagline}`,
  description = siteConfig.business.description,
} = Astro.props;

// LocalBusiness structured data — every field here is a verified fact from
// Booksy/Instagram (see site-config.ts). Fields we couldn't verify (phone,
// canonical domain) are omitted rather than guessed.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  name: siteConfig.business.name,
  description: siteConfig.business.description,
  address: {
    "@type": "PostalAddress",
    streetAddress: "MEDUSA, 15 Carlton Place",
    addressLocality: "Southampton",
    postalCode: "SO15 2DY",
    addressCountry: "GB",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: siteConfig.stats.rating,
    reviewCount: siteConfig.stats.reviewCount,
  },
  priceRange: "£10–£34",
  openingHoursSpecification: siteConfig.hours
    .filter((h) => h.time !== "Closed")
    .map((h) => {
      const [opens, closes] = h.time.split(" – ");
      return {
        "@type": "OpeningHoursSpecification",
        dayOfWeek: h.day,
        opens,
        closes,
      };
    }),
  sameAs: siteConfig.social.map((s) => s.href),
  url: siteConfig.booking.url,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0b" />

    <!-- Open Graph / social preview -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- LocalBusiness structured data — verified facts only, see above -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Fonts: Fraunces (display/editorial) + Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SmoothScroll client:load />
    <Header
      client:load
      nav={siteConfig.nav}
      businessName={siteConfig.business.shortName}
      bookingUrl={siteConfig.booking.url}
      bookingLabel={siteConfig.booking.label}
      logoSrc={logoBadge.src}
      logoWidth={logoBadge.attributes.width}
      logoHeight={logoBadge.attributes.height}
    />

    <main>
      <slot />
    </main>

    <Footer />
    <MobileBookingBar />
  </body>
</html>
